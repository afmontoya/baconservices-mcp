hs, with up to colors flat colours. Best for logos, icons, illustrations and flat artwork; a photo comes back as a stylised poster. The image is traced at up to 1000 pixels on its longest side; the SVG declares the input's own width and height (capped at 4096) and its viewBox is the traced size.","version":1,"input_version":1,"output_version":1,"price":{"amount":"50000","asset":"0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913","symbol":"USDC","decimals":6,"display":"0.05 USDC"},"endpoint":{"method":"POST","url":"https://baconservices.com/api/agent-commerce/v1/capabilities/vectorize/execute","content_type":"application/json"},"input":{"type":"object","description":"Give exactly one of image_url or image_base64. The same request body must be sent again with the PAYMENT-SIGNATURE header.","properties":{"image_url":{"type":"string","format":"uri","description":"A public https URL of a PNG, JPEG or WebP image."},"image_base64":{"type":"string","contentEncoding":"base64","description":"The image bytes, base64-encoded."},"colors":{"type":"integer","minimum":2,"maximum":32,"default":16,"description":"How many flat colours to trace with. 2 is black and white."},"detail":{"type":"string","enum":["smooth","balanced","detailed"],"default":"balanced","description":"smooth: fewer, simpler shapes. detailed: closer to the source, larger file."}},"additionalProperties":false},"output":{"kind":"artifact","mime":"image/svg+xml","description":"An SVG of filled paths. width and height are the input's (capped at 4096); the viewBox is the traced size.","schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"const":true},"request_id":{"type":"string"},"capability":{"const":"vectorize"},"artifact":{"type":"object","properties":{"url":{"type":"string","format":"uri"},"mime":{"const":"image/svg+xml"},"bytes":{"type":"integer","minimum":1},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"expires_at":{"type":"string"}},"r