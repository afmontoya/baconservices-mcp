048,"pattern":"^https://","description":"A public https URL of an SVG file, at most 1 MB, served as image/svg+xml, application/xml, text/xml, text/plain."},"precision":{"type":"integer","minimum":1,"maximum":6,"default":3,"description":"Decimals kept on coordinates. A drawing under 100 units across keeps one more per factor of ten."},"simplify":{"type":"string","enum":["none","light","strong"],"default":"none","description":"none: the drawing looks the same. light or strong: points on straight runs move within 0.05% or 0.2% of the drawing's diagonal."},"keep_ids":{"type":"boolean","default":false,"description":"Keep every id and class, for an SVG a page's own CSS or script uses."}},"additionalProperties":false},"output":{"kind":"json","mime":"application/json","description":"The cleaned SVG as a string, the byte counts before and after, what was removed by kind, and warnings.","schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"ok":{"const":true},"request_id":{"type":"string"},"capability":{"const":"svg-cleanup"},"result":{"type":"object","properties":{"svg":{"type":"string","description":"The cleaned SVG."},"input_bytes":{"type":"integer","minimum":0},"output_bytes":{"type":"integer","minimum":0},"saved_percent":{"type":"number","description":"Below zero if the output is larger."},"width":{"type":["string","null"],"description":"The root's width, as written."},"height":{"type":["string","null"]},"view_box":{"type":["string","null"]},"elements_before":{"type":"integer","minimum":0},"elements_after":{"type":"integer","minimum":0},"precision":{"type":"integer","minimum":1,"maximum":8,"description":"The decimals used."},"simplify":{"enum":["none","light","strong"]},"points_removed":{"type":"integer","minimum":0},"removed":{"type":"object","properties":{"unsafe":{"type":"integer","minimum":0},"animation":{"type":"integer","minimum":0},"links":{"type":"integer","minimum":0},"external_references":{"type":"integer","minimum":0}